{
  "name": "demonictutor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../.. --target web --out-dir apps/web/src/wasm/pkg --out-name demonictutor_ui",
    "predev": "npm run build:wasm",
    "dev": "vite",
    "deps:check": "node ./scripts/check-direct-deps.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "prebuild": "npm run build:wasm",
    "build": "npm run typecheck && vite build",
    "check": "npm run format:check && npm run lint && npm run build && npm run test && npm run audit && npm run deps:check",
    "audit": "npm audit --audit-level=moderate",
    "preview": "vite preview"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@solidjs/testing-library": "0.8.10",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@10.9.4"
}
